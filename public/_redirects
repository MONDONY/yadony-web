# L'app mobile (dony_app, legal_web_view_screen.dart) ouvre ces URL en
# WebView : elles doivent répondre. Redirections 301 vers les pages réelles.
/legal/terms /cgu 301
/legal/privacy /confidentialite 301

# L'espace pro vit sur le VPS, exposé via pro.yadony.com. L'ancienne adresse
# yadony.com/pro (historique VPS + liens existants) doit continuer de mener
# au bon endroit maintenant que la racine est servie par ce site.
/pro https://pro.yadony.com 301
/pro/* https://pro.yadony.com/pro/:splat 301

# Chemins dynamiques que l'ancien vhost racine du VPS servait et que des
# liens déjà émis (QR codes, SMS, partages réseaux sociaux, app mobile)
# continuent d'utiliser. Ils visent prod.yadony.com, le nom du VPS pour tout
# ce qui n'est pas l'espace pro : pro.yadony.com reste réservé au portail
# professionnel, sinon les deux usages se mélangent dans les liens partagés
# et dans la documentation. 308 pour l'API : préserve la méthode HTTP (un
# 301 dégraderait un POST en GET).
/tracking/* https://prod.yadony.com/tracking/:splat 301
/annonce/* https://prod.yadony.com/annonce/:splat 301
/demande/* https://prod.yadony.com/demande/:splat 301

# Lien de parrainage partagé par l'app (ReferralService, yadony-back) :
# https://yadony.com/r/{code}. La page d'atterrissage est prérendue une seule
# fois, sans le code, et le lit dans la requête (app/pages/parrainage.vue).
/r/:code /parrainage?code=:code 302
/siragbe/* https://prod.yadony.com/siragbe/:splat 301
/api/* https://prod.yadony.com/api/:splat 308

# Page de suppression de compte exigée par les fiches store, servie en
# statique par le VPS.
/legal/account-deletion https://prod.yadony.com/legal/account-deletion 301
